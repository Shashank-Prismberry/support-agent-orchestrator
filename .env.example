# Copy to .env and replace the placeholder password with a local value.
# URL-encode special characters in the password.
# Never use Backend's support_ai_db database for Agent persistence.

DATABASE_URL=postgresql+asyncpg://orchestrator_user:<URL_ENCODED_PASSWORD>@localhost:5433/orchestrator_db

# Separate setting for Agent-owned Alembic operations.
AGENT_MIGRATION_DATABASE_URL=postgresql+asyncpg://orchestrator_user:<URL_ENCODED_PASSWORD>@localhost:5433/orchestrator_db
