# Copy the TEST_DATABASE_URL entry into the root .env to enable PostgreSQL
# integration tests. Tests remain skipped when TEST_DATABASE_URL is absent.
# This workstation's existing PostgreSQL server is published on localhost:5433.
# Replace the URL-encoded password placeholder; do not use support_ai_db.

TEST_DATABASE_URL=postgresql+asyncpg://orchestrator_user:<URL_ENCODED_PASSWORD>@localhost:5433/orchestrator_db
